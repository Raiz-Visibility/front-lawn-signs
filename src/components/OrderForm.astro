<!-- ORDER FORM -->
<section class="order" id="order" aria-labelledby="order-h">
  <div class="wrap">
    <div class="ribbon-wrap"><div class="ribbon pink" style="margin:0"><h2 id="order-h">Order a display</h2></div></div>
    <p class="lede">Tell us the details and we'll take it from here.</p>
    <div class="card">
      <div id="formArea">
        <div class="alert" id="formAlert" role="alert" hidden></div>
        <form id="orderForm" novalidate>
          <fieldset class="fs">
            <legend>About you</legend>
            <div class="row">
              <div class="field"><label for="name">Your name</label><input type="text" id="name" name="name" autocomplete="name" required aria-describedby="name-e"><span class="err" id="name-e"></span></div>
              <div class="row two">
                <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" autocomplete="email" required aria-describedby="email-e"><span class="err" id="email-e"></span></div>
                <div class="field"><label for="phone">Phone</label><input type="tel" id="phone" name="phone" autocomplete="tel" inputmode="tel" required aria-describedby="phone-e"><span class="err" id="phone-e"></span></div>
              </div>
            </div>
          </fieldset>

          <fieldset class="fs" aria-describedby="pkg-e">
            <legend>Your package</legend>
            <div class="picks">
              <label class="pick"><input type="radio" name="package" value="The Little Celebration ($60)" id="pkg-little"><span class="box"><b>The Little Celebration</b><em>$60 &middot; about 15 smaller decorations</em></span></label>
              <label class="pick"><input type="radio" name="package" value="The Big Celebration ($90)" id="pkg-big"><span class="box"><b>The Big Celebration</b><em>$90 &middot; plus one large personalized decoration</em></span></label>
            </div>
            <span class="err" id="pkg-e"></span>
          </fieldset>

          <fieldset class="fs">
            <legend>The celebration</legend>
            <div class="row">
              <div class="field"><label for="occasion">Occasion</label>
                <select id="occasion" name="occasion" required aria-describedby="occasion-e">
                  <option value="">Choose an occasion</option>
                  <option>Birthday</option><option>Milestone Birthday</option><option>Anniversary</option>
                  <option>Baby Announcement: It's a Girl!</option><option>Baby Announcement: It's a Boy!</option><option>Baby Announcement: Welcome Baby</option>
                  <option>Graduation</option><option>Retirement</option><option>New Home</option><option>Engagement</option><option>Congratulations</option>
                  <option>Holiday &amp; Seasonal (Elf-themed Christmas)</option><option>Flamingo Surprise</option><option>Just Because</option><option>Other</option>
                </select><span class="err" id="occasion-e"></span></div>
              <div class="field"><label for="message">Name, age or message for the display</label><input type="text" id="message" name="message" required placeholder="Example: Happy Birthday Liam! or 4 is a ROAR!" aria-describedby="message-e"><span class="err" id="message-e"></span></div>
            </div>
          </fieldset>

          <fieldset class="fs">
            <legend>Delivery address</legend>
            <div class="row">
              <div class="field"><label for="street">Street address</label><input type="text" id="street" name="street" autocomplete="address-line1" required aria-describedby="street-e"><span class="err" id="street-e"></span></div>
              <div class="row two">
                <div class="field"><label for="town">Town</label><input type="text" id="town" name="town" autocomplete="address-level2" required aria-describedby="town-e"><span class="err" id="town-e"></span></div>
                <div class="field"><label for="postal">Postal code</label><input type="text" id="postal" name="postal" autocomplete="postal-code" placeholder="L3W 0A1" maxlength="7" required aria-describedby="postal-e"><span class="err" id="postal-e"></span></div>
              </div>
            </div>
          </fieldset>

          <fieldset class="fs">
            <legend>When</legend>
            <div class="row two">
              <div class="field"><label for="date">Display date</label><input type="date" id="date" name="date" required aria-describedby="date-e"><span class="err" id="date-e"></span></div>
              <div class="field"><label for="window">Preferred setup time window</label>
                <select id="window" name="window" required aria-describedby="window-e">
                  <option value="">Choose a window</option><option>Morning</option><option>Midday</option><option>Afternoon</option><option>Evening</option><option>Flexible, any time works</option>
                </select><span class="err" id="window-e"></span></div>
            </div>
            <p class="hint" style="margin-top:8px">We set up the same day and pick up the next day.</p>
          </fieldset>

          <fieldset class="fs">
            <legend>The card</legend>
            <div class="row">
              <div class="field"><label for="card">Greeting card message</label><textarea id="card" name="card" required aria-describedby="card-e" placeholder="What would you like the card to say?"></textarea><span class="err" id="card-e"></span></div>
              <div class="anon-box">
                <label class="check" for="anon"><input type="checkbox" id="anon" name="anon"><span><b>Keep me anonymous</b><br><span class="hint">We won't tell them who it's from.</span></span></label>
                <div class="field" id="signWrap" hidden><label for="signas">Sign the card as <span class="opt">(optional)</span></label><input type="text" id="signas" name="signas" placeholder="Example: A secret admirer"></div>
              </div>
              <div class="field"><label for="notes">Notes or special requests <span class="opt">(optional)</span></label><textarea id="notes" name="notes" style="min-height:90px"></textarea></div>
            </div>
          </fieldset>

          <button class="btn btn-pink submit" type="submit">Send My Order Request!</button>
          <p class="fine">We'll confirm availability and payment details with you directly.</p>
        </form>
      </div>
      <div id="thanks" class="thanks" hidden tabindex="-1">
        <h3>Thank you! Your request is in.</h3>
        <p>We'll be in touch soon to confirm availability and payment details. Get ready to surprise someone!</p>
        <div id="devNote" class="devnote" hidden><b>Preview mode.</b> Nothing was sent because the owner's email or form address hasn't been added to this page yet. Copy the request below and send it by hand if you're testing.</div>
        <div class="summary" id="summary"></div>
        <div class="cta-row" style="justify-content:center">
          <button class="btn btn-sm btn-white" type="button" id="copyBtn">Copy request</button>
          <button class="btn btn-sm" type="button" id="againBtn">Start another order</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import "../scripts/order";
</script>
