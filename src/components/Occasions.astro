<!-- OCCASIONS -->
<section class="band sky" id="occasions" aria-labelledby="occ-h">
  <div class="wrap">
    <div class="ribbon-wrap"><div class="ribbon" style="margin:0"><h2 id="occ-h">Celebrate anything</h2></div></div>
    <p class="lede">If it's worth cheering for, it's worth a lawn display. Here are a few ideas.</p>
    <ul class="tiles">
      <li class="tile t-pink"><svg aria-hidden="true"><use href="#i-balloon" style="color:#FFD21F"/></svg><h3>Birthdays</h3><p class="say">"Happy Birthday Liam!"</p></li>
      <li class="tile t-yellow"><svg aria-hidden="true"><use href="#i-star" style="color:#E6177F"/></svg><h3>Milestone Birthdays</h3><p class="say">"4 is a ROAR!" "Cheers to 40!"</p></li>
      <li class="tile t-cyan wide"><svg aria-hidden="true"><use href="#i-gift" style="color:#FFD21F"/></svg><h3>Baby Announcements</h3>
        <div class="baby"><span>It's a Girl!</span><span>It's a Boy!</span><span>Welcome Baby</span></div></li>
      <li class="tile t-purple"><svg aria-hidden="true"><use href="#i-heart" style="color:#FF6FB0"/></svg><h3>Anniversaries</h3><p class="say">"25 years of love!"</p></li>
      <li class="tile t-green"><svg aria-hidden="true"><use href="#i-cap" style="color:#6A2FD0"/></svg><h3>Graduations</h3><p class="say">"Congrats, Grad!"</p></li>
      <li class="tile t-sky"><svg aria-hidden="true"><use href="#i-sun" style="color:#FFD21F"/></svg><h3>Retirement</h3><p class="say">"Happy Retirement, Sue!"</p></li>
      <li class="tile t-white"><svg aria-hidden="true"><use href="#i-house" style="color:#19C7D9"/></svg><h3>New Home</h3><p class="say">"Welcome Home!"</p></li>
      <li class="tile t-pink"><svg aria-hidden="true"><use href="#i-ring" style="color:#FFD21F"/></svg><h3>Engagements</h3><p class="say">"She said YES!"</p></li>
      <li class="tile t-yellow"><svg aria-hidden="true"><use href="#i-star" style="color:#19C7D9"/></svg><h3>Congratulations</h3><p class="say">"You did it!"</p></li>
      <li class="tile t-green wide"><svg aria-hidden="true"><use href="#i-tree" style="color:#E6177F"/></svg><h3>Holiday &amp; Seasonal</h3><p class="say">Elf-themed Christmas displays</p></li>
      <li class="tile t-purple wide full"><svg aria-hidden="true"><use href="#i-heart" style="color:#FFD21F"/></svg><h3>"Just Because" surprises</h3><p class="say">"You're awesome!"</p></li>
    </ul>
    <p class="lede" style="margin:26px auto 0">Don't see yours? Choose "Other" on the order form and tell us what you have in mind.</p>
  </div>
</section>
<div class="grass" aria-hidden="true" style="background-color:var(--sky-light)"></div><div class="grass-fill" aria-hidden="true"></div>
