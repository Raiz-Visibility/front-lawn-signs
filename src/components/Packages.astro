<!-- PACKAGES -->
<section class="band white" id="packages" aria-labelledby="pack-h">
  <div class="wrap">
    <div class="ribbon-wrap"><div class="ribbon cyan" style="margin:0"><h2 id="pack-h">Pick your package</h2></div></div>
    <p class="lede">Delivery, setup and pickup are included in both.</p>
    <div class="packs">
      <article class="pack">
        <p class="tag">Package 1</p>
        <h3>The Little Celebration</h3>
        <p class="price">$60</p>
        <ul class="checks">
          <li><svg aria-hidden="true"><use href="#i-check"/></svg><span>A yard full of approximately 15 smaller decorations</span></li>
          <li><svg aria-hidden="true"><use href="#i-check"/></svg><span>Birthday or special occasion theme</span></li>
          <li><svg aria-hidden="true"><use href="#i-check"/></svg><span>Personalized greeting card with a message from the person who purchased it</span></li>
          <li><svg aria-hidden="true"><use href="#i-check"/></svg><span>Delivery, setup and pickup included within our service area</span></li>
          <li><svg aria-hidden="true"><use href="#i-check"/></svg><span>1 day rental</span></li>
        </ul>
        <a class="btn btn-white" href="#order" data-pick="little" style="width:100%">Choose Little</a>
      </article>
      <article class="pack pop">
        <span class="badge">Most Popular</span>
        <p class="tag">Package 2</p>
        <h3>The Big Celebration</h3>
        <p class="price">$90</p>
        <ul class="checks">
          <li><svg aria-hidden="true"><use href="#i-check"/></svg><span class="plus">Everything in Package 1, plus:</span></li>
          <li><svg aria-hidden="true"><use href="#i-check"/></svg><span>One large personalized decoration</span></li>
          <li><svg aria-hidden="true"><use href="#i-check"/></svg><span>A custom name, age or message</span></li>
        </ul>
        <a class="btn btn-pink" href="#order" data-pick="big" style="width:100%">Choose Big</a>
      </article>
    </div>
    <p class="packnote">Same-day setup &amp; next-day pickup.</p>
  </div>
</section>
<div class="grass" aria-hidden="true" style="background-color:#fff"></div><div class="grass-fill" aria-hidden="true"></div>
