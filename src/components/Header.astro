---
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
---
<header class="top">
  <div class="wrap">
    <a class="logo" href="#top" aria-label="Front Yard Signs, back to top">
      <Image src={logo} alt="" width={72} height={72} densities={[1, 2]} loading="eager" />
    </a>
    <a class="btn btn-pink btn-sm" href="#order">Order a Display</a>
  </div>
</header>
